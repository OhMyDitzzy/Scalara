<resources xmlns:tools="http://schemas.android.com/tools">
    <style
        name="Scalara.AppTheme"
        parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_theme_primary</item>
        <item name="colorOnPrimary">@color/blue_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/blue_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/blue_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/blue_theme_secondary</item>
        <item name="colorOnSecondary">@color/blue_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/blue_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/blue_theme_onSecondaryContainer</item>
        <item name="colorTertiary">@color/blue_theme_tertiary</item>
        <item name="colorOnTertiary">@color/blue_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/blue_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/blue_theme_onTertiaryContainer</item>
        <item name="colorError">@color/blue_theme_error</item>
        <item name="colorOnError">@color/blue_theme_onError</item>
        <item name="colorErrorContainer">@color/blue_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/blue_theme_onErrorContainer</item>
        <item name="colorSurface">@color/blue_theme_surface</item>
        <item name="colorOnSurface">@color/blue_theme_onSurface</item>
        <item name="colorOnSurfaceVariant">@color/blue_theme_onSurfaceVariant</item>
        <item name="colorOutline">@color/blue_theme_outline</item>
        <item name="colorOutlineVariant">@color/blue_theme_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/blue_theme_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/blue_theme_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/blue_theme_inversePrimary</item>
        <item name="colorPrimaryFixed">@color/blue_theme_primaryFixed</item>
        <item name="colorOnPrimaryFixed">@color/blue_theme_onPrimaryFixed</item>
        <item name="colorPrimaryFixedDim">@color/blue_theme_primaryFixedDim</item>
        <item name="colorOnPrimaryFixedVariant">@color/blue_theme_onPrimaryFixedVariant</item>
        <item name="colorSecondaryFixed">@color/blue_theme_secondaryFixed</item>
        <item name="colorOnSecondaryFixed">@color/blue_theme_onSecondaryFixed</item>
        <item name="colorSecondaryFixedDim">@color/blue_theme_secondaryFixedDim</item>
        <item name="colorOnSecondaryFixedVariant">@color/blue_theme_onSecondaryFixedVariant</item>
        <item name="colorTertiaryFixed">@color/blue_theme_tertiaryFixed</item>
        <item name="colorOnTertiaryFixed">@color/blue_theme_onTertiaryFixed</item>
        <item name="colorTertiaryFixedDim">@color/blue_theme_tertiaryFixedDim</item>
        <item name="colorOnTertiaryFixedVariant">@color/blue_theme_onTertiaryFixedVariant</item>
        <item name="colorSurfaceDim">@color/blue_theme_surfaceDim</item>
        <item name="colorSurfaceBright">@color/blue_theme_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/blue_theme_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/blue_theme_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/blue_theme_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/blue_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/blue_theme_surfaceContainerHighest</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item
            name="android:windowLightNavigationBar"
            tools:targetApi="o_mr1">true</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style
        name="Widget.Scalara.CardView.Choice"
        parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/setup_choice_card_background</item>
        <item name="strokeColor">@color/setup_choice_card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="rippleColor">@color/setup_choice_card_ripple</item>
        <item name="android:stateListAnimator">@animator/setup_choice_card_elevation</item>
        <item name="checkedIcon">@null</item>
    </style>

    <!-- ================================================================
         M3 Expressive component styles — scoped to the Main screen only.
         Each style below is applied explicitly via `style=` in
         activity_main.xml / item_resolution_preset.xml. Nothing here is
         wired into the theme's global shapeAppearanceCorner* slots, so
         every other screen (Setup, Settings, About, bottom sheets, dialogs)
         keeps stock M3 shapes untouched.

         The shared idea: non-uniform corners (one corner deliberately
         larger than the other three) instead of the flat, symmetric
         rounded rectangles standard M3 defaults to.
         ================================================================ -->

    <!-- Fully-rounded pill shape, used for the icon "blob" and the FAB
         where a symmetric stadium shape reads better than an asymmetric
         corner. -->
    <style name="ShapeAppearance.Scalara.Full" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Asymmetric medium corner for the preset row cards. -->
    <style name="ShapeAppearance.Scalara.CornerMedium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
        <item name="cornerSizeBottomLeft">12dp</item>
    </style>

    <!-- Hero card: default-resolution summary. Larger, more deliberately
         asymmetric corner than a standard M3 filled card, plus a slightly
         bolder tonal fill so it reads as the screen's focal point. -->
    <style name="Widget.Scalara.CardView.Hero" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Scalara.Hero</item>
    </style>
    <style name="ShapeAppearance.Scalara.Hero" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomRight">48dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
    </style>

    <!-- The small icon "blob" inside the hero card: fully rounded rather
         than a rounded-square, for a softer, more organic focal shape. -->
    <style name="Widget.Scalara.IconBlob" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorOnPrimaryContainer</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Scalara.Full</item>
    </style>

    <!-- Preset row card: asymmetric small-corner shape. Ripple tints toward
         primary (rather than the default neutral ripple) so a tapped preset
         visibly "responds" as an expressive, on-brand interaction. -->
    <style name="Widget.Scalara.CardView.Preset" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Scalara.CornerMedium</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- Extended FAB: pill-shaped rather than the default rounded-square
         FAB corner, tonal container colour instead of solid primary. -->
    <style name="Widget.Scalara.ExtendedFab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="iconTint">?attr/colorOnPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Scalara.Full</item>
    </style>

    <!-- Large flexible-style title for the Main toolbar: bigger and bolder
         than the default MaterialToolbar title, closer to M3E's emphasis
         on typography as a visual anchor rather than a plain app-bar label. -->
    <style name="TextAppearance.Scalara.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Section eyebrow label ("Presets") with letter-spacing, read as a
         small expressive label rather than a plain muted TitleSmall. -->
    <style name="TextAppearance.Scalara.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style
        name="Scalara.SplashTheme"
        parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/blue_theme_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/blue_theme_primaryContainer</item>
        <item name="windowSplashScreenAnimationDuration">450</item>
        <item name="postSplashScreenTheme">@style/Scalara.AppTheme</item>
    </style>
    <style
        name="Scalara.CrashDialogTheme"
        parent="Scalara.AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>