    <!-- ============================================================
         Disclaimer screen
         Shown once, on first launch after install, before setup.
         ============================================================ -->
    <string name="disclaimer_title">Sebelum Anda melanjutkan</string>
    <string name="disclaimer_heading_what">Fungsi Scalara</string>
    <string name="disclaimer_body_what">Scalara mengubah resolusi layar perangkat Anda tanpa root, menggunakan izin sistem WRITE_SECURE_SETTINGS dan mekanisme WindowManager yang sama di balik \"adb shell wm size\". Izin ini tidak dapat diberikan melalui jendela izin biasa \u2014 izin harus diberikan sekali melalui ADB, atau dikelola melalui Shizuku, sebelum Scalara dapat melakukan apa pun.</string>
    <string name="disclaimer_heading_risks">Harap pahami risikonya</string>
    <string name="disclaimer_body_risks">WRITE_SECURE_SETTINGS memungkinkan aplikasi mengubah pengaturan sistem yang aman, tidak hanya resolusi layar. Scalara hanya menggunakannya untuk mengubah resolusi dan kepadatan (density), tetapi Anda memercayai Scalara dengan izin yang, secara prinsip, dapat memengaruhi pengaturan sistem lainnya.\n\nMengatur resolusi yang tidak biasa dapat membuat beberapa aplikasi tidak ditampilkan dengan benar, membuat teks atau kontrol di layar sulit dibaca, atau dalam kasus yang jarang terjadi, membuat layar sulit dinavigasi hingga resolusi diatur ulang. Jika itu terjadi, Anda biasanya dapat memulihkannya dengan menghubungkan kembali ADB dan menjalankan perintah atur ulang (reset), atau melalui Pengaturan pada perangkat yang menyediakan opsi ukuran tampilan.</string>
    <string name="disclaimer_heading_independence">Proyek independen</string>
    <string name="disclaimer_body_independence">Scalara adalah proyek sumber terbuka (open-source) yang independen. Aplikasi ini tidak berafiliasi dengan, didukung oleh, atau ditopang oleh Google maupun produsen perangkat Anda.</string>
    <string name="disclaimer_heading_consent">Persetujuan Anda</string>
    <string name="disclaimer_body_consent">Dengan mengetuk \"Saya paham dan setuju\", Anda mengonfirmasi bahwa Anda telah membaca ketentuan di atas, memahami risiko dari pemberian izin WRITE_SECURE_SETTINGS, dan setuju untuk melanjutkan atas tanggung jawab Anda sendiri. Layar ini hanya muncul sekali, saat pertama kali Scalara dipasang.</string>
    <string name="disclaimer_scroll_hint">Gulir ke paling bawah untuk melanjutkan</string>
    <string name="disclaimer_button_decline">Tolak dan keluar</string>
    <string name="disclaimer_button_accept">Saya paham dan setuju</string>

    <!-- ============================================================
         Setup wizard \u2014 shared
         ============================================================ -->
    <string name="setup_title">Pengaturan izin</string>
    <string name="setup_step_indicator">Langkah %1$d dari %2$d</string>
    <string name="setup_button_back">Kembali</string>
    <string name="setup_button_next">Lanjut</string>

    <!-- Step 1: method choice -->
    <string name="setup_choose_title">Pilih cara memberikan izin</string>
    <string name="setup_choose_subtitle">Scalara membutuhkan WRITE_SECURE_SETTINGS untuk mengubah resolusi layar Anda. Pilih salah satu dari dua metode yang didukung di bawah ini.</string>
    <string name="setup_choose_adb_title">ADB</string>
    <string name="setup_choose_adb_description">Berikan izin sekali dari komputer menggunakan satu perintah ADB. Izin tersebut kemudian akan tersimpan secara permanen \u2014 Scalara tidak akan menghubungi Shizuku sama sekali.</string>
    <string name="setup_choose_shizuku_title">Shizuku</string>
    <string name="setup_choose_shizuku_description">Biarkan aplikasi Shizuku mengelola izin untuk Anda. Tidak memerlukan komputer setelah Shizuku itu sendiri berjalan, tetapi Scalara bergantung pada layanan Shizuku yang harus tetap aktif.</string>
    <string name="setup_choose_recommended_badge">Tidak perlu komputer</string>

    <!-- Step 2: ADB flow -->
    <string name="setup_adb_title">Berikan izin via ADB</string>
    <string name="setup_adb_instructions">1. Hubungkan perangkat ini ke komputer yang sudah terpasang ADB, dengan penelusuran kesalahan USB (USB debugging) diaktifkan.\n2. Buka terminal di komputer tersebut.\n3. Jalankan perintah di bawah ini.\n4. Kembali ke sini dan ketuk \"Verifikasi izin\".</string>
    <string name="setup_adb_command_label">Perintah untuk dijalankan</string>
    <string name="setup_adb_copy_command">Salin perintah</string>
    <string name="setup_adb_command_copied">Perintah disalin ke papan klip</string>
    <string name="setup_adb_permanent_note">Setelah diberikan dengan cara ini, izin akan dianggap permanen. Scalara tidak akan meminta binder Shizuku atau meminta Anda memasang Shizuku.</string>
    <string name="setup_button_verify_permission">Verifikasi izin</string>
    <string name="setup_adb_not_granted_yet">Izin belum terdeteksi. Jalankan perintah di atas, lalu coba lagi.</string>

    <!-- Step 2: Shizuku flow -->
    <string name="setup_shizuku_title">Berikan izin via Shizuku</string>
    <string name="setup_shizuku_instructions">1. Pasang Shizuku jika Anda belum memasangnya.\n2. Jalankan layanan Shizuku dari aplikasi Shizuku (melalui penautan ADB atau root, tergantung pada perangkat Anda).\n3. Kembali ke sini dan ketuk \"Minta izin\".</string>
    <string name="setup_shizuku_get_app">Dapatkan Shizuku</string>
    <string name="setup_shizuku_status_not_running">Layanan Shizuku tidak berjalan</string>
    <string name="setup_shizuku_status_running_no_permission">Shizuku berjalan \u2014 izin belum diberikan</string>
    <string name="setup_shizuku_status_granted">Shizuku berjalan dan izin telah diberikan</string>
    <string name="setup_shizuku_status_denied_permanently">Izin ditolak dengan opsi \"jangan tanya lagi\". Berikan izin dari layar aplikasi Shizuku itu sendiri.</string>
    <string name="setup_button_request_permission">Minta izin</string>
    <string name="setup_button_open_shizuku">Buka Shizuku</string>

    <!-- Step 3: verified / done -->
    <string name="setup_done_title">Semua telah siap</string>
    <string name="setup_done_body_adb">Izin WRITE_SECURE_SETTINGS telah terdeteksi. Scalara akan menganggap izin ini permanen.</string>
    <string name="setup_done_body_shizuku">Izin telah diberikan melalui Shizuku. Pastikan layanan Shizuku tetap berjalan agar Scalara dapat terus berfungsi.</string>
    <string name="setup_button_finish">Lanjutkan ke Scalara</string>

