<?xml version="1.0" encoding="utf-8"?>
<!--
     Base vector for the animated "setup complete" checkmark.
     Two separate strokes so trimPathStart/trimPathEnd can animate them
     in sequence: the circle outline draws first, then the check mark.
     Colours are resolved from theme attrs via themeless android:tint on
     the ImageView, so this stays correct in both light and dark theme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:name="root"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <group
        android:name="scale_group"
        android:pivotX="32"
        android:pivotY="32"
        android:scaleX="0.6"
        android:scaleY="0.6">

    <group android:name="circle_group">
        <path
            android:name="circle_path"
            android:pathData="M32,4 C16.54,4 4,16.54 4,32 C4,47.46 16.54,60 32,60 C47.46,60 60,47.46 60,32 C60,16.54 47.46,4 32,4 Z"
            android:strokeColor="@android:color/white"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:trimPathStart="0"
            android:trimPathEnd="0" />
    </group>

    <group android:name="check_group">
        <path
            android:name="check_path"
            android:pathData="M20,33 L27.5,40.5 L44,22"
            android:strokeColor="@android:color/white"
            android:strokeWidth="4.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:trimPathStart="0"
            android:trimPathEnd="0" />
    </group>

    </group>

</vector>
